generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPERADMIN
  ORGANIZER
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         Role          @default(ORGANIZER)
  active       Boolean       @default(true)
  orgId        String?
  org          Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  memberships  TournamentMember[]
}

model Organization {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  logo         Bytes?
  logoType     String?
  colorPrimary String       @default("#b91c1c")
  colorAccent  String       @default("#111827")
  tvTheme      String       @default("dark")
  corner1Name  String       @default("Rojo")
  corner1Color String       @default("#dc2626")
  corner2Name  String       @default("Azul")
  corner2Color String       @default("#2563eb")
  showFlags    Boolean      @default(true)
  showTeams    Boolean      @default(true)
  updatedAt    DateTime     @updatedAt
  createdAt    DateTime     @default(now())
  users        User[]
  tournaments  Tournament[]
}

model Tournament {
  id           String        @id @default(cuid())
  orgId        String
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  slug         String        @unique
  date         DateTime?
  location     String?
  published    Boolean       @default(true)
  quick        Boolean       @default(false)
  mesaCode     String?       @unique
  createdAt    DateTime      @default(now())
  areas        Area[]
  categories   Category[]
  participants Participant[]
  members      TournamentMember[]

  @@index([orgId])
}

model Area {
  id             String       @id @default(cuid())
  tournamentId   String
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name           String
  order          Int          @default(0)
  judges         Int          @default(3)
  currentMatchId String?      @unique
  currentMatch   Match?       @relation("AreaCurrent", fields: [currentMatchId], references: [id], onDelete: SetNull)
  categories     Category[]

  @@index([tournamentId])
}

model Category {
  id              String     @id @default(cuid())
  tournamentId    String
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name            String
  ruleset         String
  gender          String?
  ageGroup        String?
  level           String?
  weightMin       Float?
  weightMax       Float?
  rounds          Int
  roundSeconds    Int
  restSeconds     Int
  format          String     @default("AUTO")
  thirdPlaceMatch Boolean    @default(false)
  autoLadder      Boolean    @default(true)
  dqAt            Int?
  minusMode       String?
  minusValue      Int?
  bracketFormat   String?
  areaId          String?
  area            Area?      @relation(fields: [areaId], references: [id], onDelete: SetNull)
  order           Int        @default(0)
  entries         Entry[]
  matches         Match[]

  @@index([tournamentId])
}

model Participant {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  team         String?
  country      String?
  gender       String?
  birthYear    Int?
  level        String?
  weight       Float?
  weighIn      Float?
  checkedIn    Boolean    @default(false)
  photoVersion Int        @default(0)
  photo        ParticipantPhoto?
  createdAt    DateTime   @default(now())
  entries      Entry[]

  @@index([tournamentId])
}

model Entry {
  id            String      @id @default(cuid())
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  seed          Int?
  redMatches    Match[]     @relation("MatchRed")
  blueMatches   Match[]     @relation("MatchBlue")
  wonMatches    Match[]     @relation("MatchWinner")

  @@unique([categoryId, participantId])
}

model Match {
  id               String       @id @default(cuid())
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  round            Int
  position         Int
  depth            Int          @default(0)
  number           Int          @default(0)
  label            String?
  redEntryId       String?
  red              Entry?       @relation("MatchRed", fields: [redEntryId], references: [id], onDelete: SetNull)
  blueEntryId      String?
  blue             Entry?       @relation("MatchBlue", fields: [blueEntryId], references: [id], onDelete: SetNull)
  winnerEntryId    String?
  winner           Entry?       @relation("MatchWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  winMethod        String?
  resultSummary    String?
  nextMatchId      String?
  nextSlot         String?
  loserNextMatchId String?
  loserNextSlot    String?
  status           String       @default("PENDING")
  phase            String       @default("IDLE")
  currentRound     Int          @default(1)
  clockRunning     Boolean      @default(false)
  clockRemainingMs Int          @default(0)
  clockStartedAt   DateTime?
  finishedAt       DateTime?
  scheduledAt      DateTime?
  customRules      Boolean      @default(false)
  dqAt             Int?
  minusMode        String?
  minusValue       Int?
  events           ScoreEvent[]
  judgeCodes       MatchJudge[]
  currentInArea    Area?        @relation("AreaCurrent")

  @@index([categoryId])
}

model ScoreEvent {
  id        String   @id @default(cuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      String
  corner    String
  value     Int      @default(1)
  judge     Int?
  round     Int      @default(1)
  clientId  String?  @unique
  voided    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([matchId])
}

model MatchJudge {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seat    Int
  code    String @unique

  @@unique([matchId, seat])
}

model ParticipantPhoto {
  participantId String      @id
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  data          Bytes
  type          String
}

model TournamentMember {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([tournamentId, userId])
}
