{
  "name": "compcounter",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-flags.mjs && next dev",
    "build": "prisma generate && node scripts/copy-flags.mjs && next build",
    "start": "prisma migrate deploy && node scripts/bootstrap.mjs && next start",
    "db": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate dev",
    "db:bootstrap": "node --env-file=.env scripts/bootstrap.mjs",
    "lint": "eslint",
    "probar:puntaje": "node scripts/probar-puntaje.mjs",
    "probar:importacion": "node scripts/probar-importacion.mjs",
    "probar:controles": "node scripts/probar-controles.mjs",
    "probar:copias": "node scripts/probar-copias.mjs",
    "probar:llaves": "node scripts/probar-llaves.mjs",
    "plantilla": "node scripts/crear-plantilla.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fflate": "0.8.3",
    "flag-icons": "^7.6.0",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
